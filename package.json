{
  "name": "@explita/actyx-rpc",
  "version": "0.5.0",
  "author": "Explita",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "description": "Actyx RPC — type-safe RPC for composable server actions in TypeScript",
  "keywords": [
    "actyx",
    "rpc",
    "typescript",
    "action",
    "procedure",
    "nodejs"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./adapters/next": {
      "import": "./dist/adapters/next/index.js",
      "require": "./dist/adapters/next/index.js",
      "types": "./dist/adapters/next/index.d.ts"
    },
    "./adapters/ws": {
      "import": "./dist/adapters/ws/index.js",
      "require": "./dist/adapters/ws/index.js",
      "types": "./dist/adapters/ws/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    },
    "./client": {
      "import": "./dist/client/index.js",
      "require": "./dist/client/index.js",
      "types": "./dist/client/index.d.ts"
    },
    "./client/*": {
      "import": "./dist/client/*.js",
      "require": "./dist/client/*.js",
      "types": "./dist/client/*.d.ts"
    },
    "./resolvers": {
      "import": "./dist/resolvers/index.js",
      "require": "./dist/resolvers/index.js",
      "types": "./dist/resolvers/index.d.ts"
    },
    "./resolvers/arktype": {
      "import": "./dist/resolvers/arktype/index.js",
      "require": "./dist/resolvers/arktype/index.js",
      "types": "./dist/resolvers/arktype/index.d.ts"
    },
    "./resolvers/joi": {
      "import": "./dist/resolvers/joi/index.js",
      "require": "./dist/resolvers/joi/index.js",
      "types": "./dist/resolvers/joi/index.d.ts"
    },
    "./resolvers/valibot": {
      "import": "./dist/resolvers/valibot/index.js",
      "require": "./dist/resolvers/valibot/index.js",
      "types": "./dist/resolvers/valibot/index.d.ts"
    },
    "./resolvers/yup": {
      "import": "./dist/resolvers/yup/index.js",
      "require": "./dist/resolvers/yup/index.js",
      "types": "./dist/resolvers/yup/index.d.ts"
    },
    "./resolvers/zod": {
      "import": "./dist/resolvers/zod/index.js",
      "require": "./dist/resolvers/zod/index.js",
      "types": "./dist/resolvers/zod/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/explita/actyx-rpc.git"
  },
  "bugs": {
    "url": "https://github.com/explita/actyx-rpc/issues"
  },
  "homepage": "https://github.com/explita/actyx-rpc#readme",
  "scripts": {
    "clean": "rimraf dist",
    "copy-dist": "node scripts/copy-dist.js",
    "build": "node scripts/gen-version.js && npm run clean && tsc && npm run copy-dist",
    "dev": "tsc --watch",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^25.0.8",
    "@types/react": "^19.2.14",
    "next": "^16.2.4",
    "rimraf": "^6.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^3.0.7",
    "xhr2": "^0.2.1"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "arktype": "^2.2.0",
    "ioredis": "^5.10.1",
    "joi": "^18.1.2",
    "next": ">=16.0.0",
    "valibot": "^1.3.1",
    "yup": "^1.7.1",
    "zod": "^4.3.6"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "arktype": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "joi": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "valibot": {
      "optional": true
    },
    "yup": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
